{
    "files.associations": {
        "string": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "*.tcc": "cpp",
        "cctype": "cpp",
        "chrono": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "compare": "cpp",
        "complex": "cpp",
        "concepts": "cpp",
        "condition_variable": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "random": "cpp",
        "ratio": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "iostream": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "mutex": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "semaphore": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "stop_token": "cpp",
        "streambuf": "cpp",
        "thread": "cpp",
        "typeinfo": "cpp",
        "list": "cpp",
        "map": "cpp",
        "set": "cpp",
        "fstream": "cpp",
        "iomanip": "cpp",
        "cinttypes": "cpp",
        "forward_list": "cpp",
        "valarray": "cpp"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },

    // Keep git-ignored folders visible in Explorer so they appear dimmed instead of disappearing.
    "explorer.excludeGitIgnore": false,
    "explorer.decorations.colors": true,
    "explorer.decorations.badges": true,
    "git.decorations.enabled": true,

    "search.exclude": {
        "**/.reasonix/**": true,
        "**/.rubbish/**": true,
        "**/build/**": true,
        "**/build_host/**": true,
        "**/build_rt1064/**": true,
        "**/docs/**": true,
        "**/ls2k0300_linux_4.19/**": true,
        "**/opencv_4_10_build/**": true,
        "**/third_party/**": true,
        "**/train_data/**": true,
        "**/tests/**": true,
        "**/web/**": true,
        "**/yolo/upload/**": true,
        "**/*.code-search": true
    },
    "search.useIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,

    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.reasonix/**": true,
        "**/.rubbish/**": true,
        "**/build/**": true,
        "**/build_host/**": true,
        "**/build_rt1064/**": true,
        "**/docs/**": true,
        "**/ls2k0300_linux_4.19/**": true,
        "**/opencv_4_10_build/**": true,
        "**/third_party/**": true,
        "**/train_data/**": true,
        "**/tests/**": true,
        "**/web/**": true,
        "**/yolo/upload/**": true
    },

    "C_Cpp.default.intelliSenseMode": "gcc-x64",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.errorSquiggles": "enabledIfIncludesResolve",
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.files.exclude": {
        "**/.git/**": true,
        "**/.reasonix/**": true,
        "**/.rubbish/**": true,
        "**/.vscode/**": true,
        "**/.vs/**": true,
        "**/build/**": true,
        "**/build_host/**": true,
        "**/build_rt1064/**": true,
        "**/docs/**": true,
        "**/ls2k0300_linux_4.19/**": true,
        "**/opencv_4_10_build/**": true,
        "**/third_party/**": true,
        "**/train_data/**": true,
        "**/tests/**": true,
        "**/web/**": true,
        "**/yolo/upload/**": true
    },
    
    // clangd configuration for IntelliSense in web-based VSCode
    "clangd.arguments": [
        "--background-index=false",
        "--all-scopes-completion=false",
        "--completion-style=bundled",
        "--header-insertion=never",
        "--pch-storage=memory",
        "--limit-results=200",
        "--pretty"
    ],
    "clangd.onConfigChanged": "restart",
    "clangd.detectExtensionConflicts": true,
    
    // Enable clangd as the language server for C/C++
    "[cpp]": {
        "editor.semanticHighlighting.enabled": true
    },
    "[c]": {
        "editor.semanticHighlighting.enabled": true
    },
    "chat.tools.terminal.autoApprove": {
        "make": true,
        "nproc": true
    },
    
//     ,
//     "code-runner.executorMap": {
