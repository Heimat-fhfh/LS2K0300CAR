{
    // ============================================================
    //  串级差速外环 PD 参数（位置环）  —  最激进模式 config_2
    //  功能: 将归一化图像偏差 [-1,1] 转换为期望差速角速度
    //  公式: desiredDiffSpeed = Kp*error + Kd*(error-prevError)/dt + Kp2*error*|error|
    //  error = setpoint(0) - steerError  (feedback=归一化偏差)
    //  所有输出受 LIMIT_OUTPUT 限幅
    // ============================================================
    "DIFF_OUTER_PD_KP": 12.0,
    "DIFF_OUTER_PD_KD": 2.5,
    "DIFF_OUTER_PD_LIMIT_P": 50.0,
    "DIFF_OUTER_PD_LIMIT_D": 25.0,
    "DIFF_OUTER_PD_LIMIT_OUTPUT": 250.0,
    "DIFF_OUTER_PD_KP2": 0.0,  // 非线性比例增益: Kp2*error*|error|。大偏差时平方放大增强急弯响应。0=禁用

    // ============================================================
    //  外环 PD 输出斜坡控制
    //  功能: 限制期望差速角速度的加减速率，防止转向突变
    // ============================================================
    "DIFF_OUTPUT_RAMP_ENABLE": true,
    "DIFF_OUTPUT_RAMP_ACCEL_RATE": 15.0,   // 角加速度限幅 (rad/s²)
    "DIFF_OUTPUT_RAMP_DECEL_RATE": 30.0,   // 角减速度限幅 (rad/s²)

    // ============================================================
    //  串级差速内环 PI 参数（角速度环）
    //  功能: 跟踪外环输出的期望角速度，控制实际车身角速度
    //  公式: diffOutput = PI(setpoint=desiredDiffSpeed, feedback=gyroZ) / 2 + Gkd*gyroZ
    //  gyroZ 来自 IMU 陀螺仪 (rad/s)，带 anti-windup 防积分饱和
    // ============================================================
    "DIFF_INNER_PI_KP": 15.0,
    "DIFF_INNER_PI_KI": 0.8,
    "DIFF_INNER_PI_KD": 0.0,    // 微分增益，通常为 0（纯 PI）
    "DIFF_INNER_PI_LIMIT_P": 60.0,
    "DIFF_INNER_PI_LIMIT_I": 30.0,
    "DIFF_INNER_PI_LIMIT_D": 0.0,
    "DIFF_INNER_PI_LIMIT_OUTPUT": 0.7,
    "DIFF_INNER_PI_LIMIT_I_MIN": -0.7,  // 积分下界，负值防反向饱和，通常 = -LIMIT_OUTPUT
    "DIFF_INNER_PI_ANTI_WINDUP": true,   // 抗积分饱和使能
    "DIFF_INNER_PI_GKD": 0.0,            // 陀螺仪前馈增益: Gkd*gyroZ。负值=阻尼(抑制振荡)，正值=助动(加剧转向)，0=禁用
    "DIFF_INNER_PI_GKD_LIMIT": 3.0,      // 前馈输出限幅，防 Gkd*gyroZ 过大导致抖动

    // ============================================================
    //  速度环增量式 PID 参数
    //  功能: 控制车速跟踪目标速度（含曲率降速后的目标）
    //  算法: 增量式 Δu = Kp*Δe + Ki*e*dt + Kd*(Δ²e)/dt
    //  feedback = 左右编码器速度平均值 (m/s)
    // ============================================================
    "SPEED_INCR_PI_KP": 0.5,
    "SPEED_INCR_PI_KI": 0.5,
    "SPEED_INCR_PI_KD": 0.0,    // 微分增益，通常为 0（纯 PI）
    "SPEED_INCR_PI_LIMIT_OUTPUT": 0.7,
    
    // ============================================================
    //  功能开关
    // ============================================================
    "CAMERA_EN": 1,                   // 相机使能 0=禁用 1=USB摄像头0 2=USB摄像头1 3=MIPI
    "IMAGE_SAVE_EN": false,           // 图像存储到SD卡
    "ACROSS_IDENTIFY_EN": true,       // 十字路口识别
    "CIRCLE_IDENTIFY_EN": true,       // 环岛(圆环)识别
    "IPS200_SHOW_EN": true,           // IPS200 车载屏幕实时显示 (80x60)
    "UDP_IMAGE_UPLOAD_EN": true,      // UDP 图像上传到上位机调试
    
    // ============================================================
    //  赛道搜索参数
    // ============================================================
    "PATH_SEARCH_START": 15,          // 寻路径起始行 (近处)
    "PATH_SEARCH_END": 165,           // 寻路径结束行 (远处)
    "SIDE_SEARCH_END": 170,           // 寻边线结束行
    "Track_width": 216,               // 赛道宽度 (像素)
    
    // ============================================================
    //  赛道元素参数
    // ============================================================
    "TRANSITION_MIN_AREA": 1000,      // 独立黑色区域最小面积 (像素²)

    "STRIGHT_TRACK_MOTOR_SPEED": 90,  // 基础电机目标速度 (0~100)，最终映射为 m/s
    "CIRCLE_MAX_FRAMES": 300,         // 环岛最大帧数，防无限循环

    // ============================================================
    //  控制参数
    // ============================================================
    "CONTROL_PERIOD": 0.01,           // 控制周期 (秒)，100Hz
    "MOTOR_MAX_DUTY": 50.0,           // 电机 PWM 最大占空比 (%)，0~100

    // ============================================================
    //  低通滤波参数 (一阶 IIR)
    //  公式: y[n] = α*x_raw + (1-α)*y[n-1], α = dt/(dt+τ)
    // ============================================================
    "LPF_SPEED_TAU": 0.02,            // 编码器速度滤波时间常数 (秒)
    "LPF_ANGULAR_TAU": 0.02,          // 陀螺仪角速度滤波时间常数 (秒)

    // ============================================================
    //  电机死区 / 斜坡控制
    // ============================================================
    "MOTOR_PWM_DEAD_ZONE_LEFT": 0.01,   // 左电机死区 (0~1)，消除启动死区
    "MOTOR_PWM_DEAD_ZONE_RIGHT": 0.01,  // 右电机死区 (0~1)

    // ============================================================
    //  碰撞保护（三层检测: IMU冲击 + 堵转 + GPIO）
    // ============================================================
    "COLLISION_PROTECT_ENABLE": true,
    "COLLISION_IMU_JERK_THRESHOLD": 3.0,         // IMU 水平加速度阈值 (g)，sqrt(ax²+ay²) 超阈值触发
    "COLLISION_STALL_DUTY_THRESHOLD": 0.2,       // 堵转检测: PWM 占空比高于此值
    "COLLISION_STALL_SPEED_THRESHOLD": 0.01,     // 堵转检测: 车速低于此值 (m/s)
    "COLLISION_STALL_CYCLES": 20,                 // 堵转确认: 连续满足条件 N 个周期后触发
    "COLLISION_RESET_KEY": 0,                     // 复位按键 0=KEY0 1=KEY1 2=KEY2 3=KEY3
    "COLLISION_BUMPER_KEY": -1,                   // 碰撞开关 -1=禁用 0~3=按键

    // ============================================================
    //  斜坡限幅 (电机命令变化率限制)
    // ============================================================
    "RAMP_ACCEL_RATE": 50.0,          // 加速斜坡 (%/s)，如50即每秒最多增加50%占空比
    "RAMP_DECEL_RATE": 100.0,         // 减速斜坡 (%/s)，通常比加速率大以保证紧急刹车

    // ============================================================
    //  曲率自适应降速 (摩擦圆约束)
    //  公式: actualSpeed = baseSpeed * max(1 - gain*|error|, min)
    // ============================================================
    "CURVATURE_SPEED_GAIN": 0.4,      // 曲率降速增益 0=禁用 0.3~0.5=推荐，弯越大速度越低
    "CURVATURE_SPEED_MIN": 0.1,       // 降速下限比例，最快速度不低于 baseSpeed 的此倍数

    "BATTERY_LOW_THRESHOLD": 10000    // 电池低电压阈值 (mV)，低于此值蜂鸣器告警
}
