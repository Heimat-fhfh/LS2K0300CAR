# clangd configuration file
# For IntelliSense in web-based VSCode

# Use compile_commands.json if available
CompileFlags:
  # Use default C++ compiler (system g++)
  Compiler: g++
  
  # C++ standard and include directories
  Add: [
    -std=c++17,
    -I./include,
    -I./third_party/cpp-httplib-master,
    -I/usr/include,
    -I/usr/local/include,
    # OpenCV headers
    -I/home/fhfh/Work/LS2K0300CAR/opencv_4_10_build/include/opencv4,
    # Linux kernel headers for loongarch (optional)
    -I./ls2k0300_linux_4.19/include,
    -I./ls2k0300_linux_4.19/arch/loongarch/include,
    -I./ls2k0300_linux_4.19/arch/loongarch/include/generated,
    # Other compiler flags
    -Wall,
    -Wextra,
    -pthread
  ]
  
  # Defines if any (from CMakeLists.txt)
  # Add: [-DDEBUG]

# Diagnostics settings
Diagnostics:
  # Enable clang-tidy checks
  ClangTidy: {}
  # Uncomment to suppress specific warnings
  # Suppress: [unknown_typename]
  
# Index settings
Index:
  # Skip background indexing to reduce resource usage
  Background: Skip
  
# Note: compile_commands.json will be used if available
# The file at project root will be automatically detected
